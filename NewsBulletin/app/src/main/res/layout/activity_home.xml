<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/homeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_title"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/home_intro"
        android:textSize="16sp" />

    <Button
        android:id="@+id/firstArticleButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/article_1_title" />

    <Button
        android:id="@+id/secondArticleButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/article_2_title" />

    <Button
        android:id="@+id/thirdArticleButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/article_3_title" />

    <Button
        android:id="@+id/aboutButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/about_button" />
</LinearLayout>
